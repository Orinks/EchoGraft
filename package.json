{
  "name": "echograft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accessible audio-first puzzle-strategy game set in the Verdancy Ark.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:audio-assets": "node scripts/check-audio-assets.mjs",
    "check": "npm run check:audio-assets && npm run test && npm run build",
    "electron": "electron .",
    "package:electron": "electron-builder --dir"
  },
  "dependencies": {
    "syngen": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^24.1.1",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "dev.orinks.echograft",
    "productName": "EchoGraft",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
