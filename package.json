{
  "name": "echograft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Accessible audio-first puzzle-strategy game set in the Verdancy Ark.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build && node scripts/serve-public.mjs",
    "build": "gulp --gulpfile Gulpfile.cjs build",
    "preview": "node scripts/serve-public.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:audio-assets": "node scripts/check-audio-assets.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:syngen-audio": "node scripts/check-syngen-audio.mjs",
    "check": "npm run check:audio-assets && npm run check:syngen-audio && npm run test && npm run build && npm run check:performance",
    "electron": "electron .",
    "package:electron": "electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "gulp": "^5.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-header": "^2.0.9",
    "gulp-if": "^3.0.0",
    "gulp-iife": "^0.4.0",
    "gulp-rename": "^2.1.0",
    "gulp-uglify-es": "^3.0.0",
    "jsdom": "^24.1.1",
    "syngen": "^2.0.0-beta.3",
    "yargs": "^18.0.0",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "dev.orinks.echograft",
    "productName": "EchoGraft",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
